default_platform(:android)

platform :android do
  desc "Deploy to Google Play Internal Testing"
  lane :deploy_internal do
    gradle(task: "clean bundleRelease")
    upload_to_play_store(
      track: 'internal',
      release_status: 'completed',
      skip_upload_apk: true
    )
  end

  desc "Deploy to Google Play Alpha Testing"
  lane :deploy_alpha do
    gradle(task: "clean bundleRelease")
    upload_to_play_store(
      track: 'alpha',
      release_status: 'completed',
      skip_upload_apk: true
    )
  end

  desc "Deploy to Google Play Beta Testing"
  lane :deploy_beta do
    gradle(task: "clean bundleRelease")
    upload_to_play_store(
      track: 'beta',
      release_status: 'completed',
      skip_upload_apk: true
    )
  end

  desc "Deploy to Google Play Production"
  lane :deploy_production do
    gradle(task: "clean bundleRelease")
    upload_to_play_store(
      track: 'production',
      release_status: 'completed',
      skip_upload_apk: true
    )
  end

  # Legacy lanes for backward compatibility
  desc "Deploy a new version to the Google Play (legacy)"
  lane :deploy do
    deploy_production
  end

  desc "Deploy to internal testing (legacy)"
  lane :internal do
    deploy_internal
  end
end

