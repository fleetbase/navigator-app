APP_NAME=Navigator
APP_IDENTIFIER=io.fleetbase.navigator
APP_LINK_PREFIX=flbnavigator
FLEETBASE_HOST=https://api.fleetbase.io
FLEETBASE_KEY=
GOOGLE_MAPS_API_KEY=
DEFAULT_COORDINATES=1.369,103.8864

# Redesign cutover. false (default) builds the v2 app; true builds the v3 shell.
# The two presentation trees never share a Tamagui provider — see App.tsx.
NAVIGATOR_V3=false

# White-label. NAVIGATOR_BRAND picks a preset (fleetbase | acme | blue | red |
# green | indigo | orange); NAVIGATOR_BRAND_PRIMARY overrides it with raw hex.
# APP_THEME is still honoured for existing builds.
# NAVIGATOR_BRAND=fleetbase
# NAVIGATOR_BRAND_PRIMARY=#3D7BFA

# Per-scheme colour overrides, applied last so they actually win (they did not
# in v2). Format: key:value,key2:value2 — hex only.
# CUSTOM_COLORS=
# CUSTOM_COLORS_LIGHT=
# CUSTOM_COLORS_DARK=
# CUSTOM_COLORS_NIGHT=
# CUSTOM_COLORS_SUNLIGHT=
